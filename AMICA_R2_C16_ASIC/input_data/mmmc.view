# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

if {![info exists PROJ_DIR]} {
    if {[info exists env(PROJECT_ROOT)]} {
        set PROJ_DIR [file normalize $env(PROJECT_ROOT)]
    } elseif {[file exists "./input_data"]} {
        set PROJ_DIR [file normalize "."]
    } elseif {[file exists "../input_data"]} {
        set PROJ_DIR [file normalize ".."]
    } else {
        set PROJ_DIR [file normalize ".."]
    }
}

# Canonical MMMC setup for the bundled GPDK/gsclib045 collateral.

create_library_set -name gsclib045_fast \
   -timing [list \
      ${PROJ_DIR}/input_data/lib/stdcells-bc.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_4x2048_1rw_FF_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x1024_1rw_FF_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x4096_1rw_FF_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x256_1rw_FF_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x512_1rw_FF_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x16_1rw_FF_1p0V_25C.lib \
   ]

create_library_set -name gsclib045_slow \
   -timing [list \
      ${PROJ_DIR}/input_data/lib/stdcells-wc.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_4x2048_1rw_SS_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x1024_1rw_SS_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x4096_1rw_SS_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x256_1rw_SS_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x512_1rw_SS_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x16_1rw_SS_1p0V_25C.lib \
   ]

create_library_set -name gsclib045_typical \
   -timing [list \
      ${PROJ_DIR}/input_data/lib/stdcells.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_4x2048_1rw_TT_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x1024_1rw_TT_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x4096_1rw_TT_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x256_1rw_TT_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x512_1rw_TT_1p0V_25C.lib \
      ${PROJ_DIR}/input_data/lib/SRAM_16x16_1rw_TT_1p0V_25C.lib \
   ]

create_op_cond -name FAST \
   -library_file ${PROJ_DIR}/input_data/lib/stdcells-bc.lib \
   -P 1.0 -V 1.25 -T 0

create_op_cond -name SLOW \
   -library_file ${PROJ_DIR}/input_data/lib/stdcells-wc.lib \
   -P 1.0 -V 0.95 -T 125

create_op_cond -name TYPICAL \
   -library_file ${PROJ_DIR}/input_data/lib/stdcells.lib \
   -P 1.0 -V 1.1 -T 25

# rc corner
create_rc_corner -name rc_best \
   -cap_table ${PROJ_DIR}/input_data/captbl/rtk-typical.captable \
   -T 0

create_rc_corner -name rc_worst \
   -cap_table ${PROJ_DIR}/input_data/captbl/rtk-typical.captable \
   -T 125

create_rc_corner -name rc_typ \
   -cap_table ${PROJ_DIR}/input_data/captbl/rtk-typical.captable \
   -T 25

# constraint
create_constraint_mode -name func_mode \
   -sdc_files [list ${PROJ_DIR}/input_data/sdc/constraints.sdc]

# delay corner
create_delay_corner -name delay_fast \
   -library_set gsclib045_fast \
   -opcond FAST \
   -rc_corner rc_best

create_delay_corner -name delay_slow \
   -library_set gsclib045_slow \
   -opcond SLOW \
   -rc_corner rc_worst

create_delay_corner -name delay_typical \
   -library_set gsclib045_typical \
   -opcond TYPICAL \
   -rc_corner rc_typ

# analysis view
create_analysis_view -name func_view_setup \
   -constraint_mode func_mode \
   -delay_corner delay_slow

create_analysis_view -name func_view_hold \
   -constraint_mode func_mode \
   -delay_corner delay_fast

create_analysis_view -name func_view_typical \
   -constraint_mode func_mode \
   -delay_corner delay_typical

set_analysis_view \
   -setup {func_view_setup} \
   -hold {func_view_hold}
